<!-- Frames -->
<!--   base_link:  center of robot chassis -->
<!--   base_footprint:  "footprint" of robot on ground -->
<!--   odom:  NOT set in URDF. Published by odometry node (robot_localization EKF) -->
<!--   lidar_link:  lidar frame for realsense -->
<!--   misc camera frames:  for realsense depth/color -->

<robot name="SLAMurai">
  <!-- Base footprint (on ground) -->
  <link name="base_footprint">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <!-- Base link (chassis plate) -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.005"/>
      </geometry>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- Realsense D455 -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0 0.05" rpy="0.0 0 3.14159"/>
  </joint>

  
  <link name="camera_depth_optical_frame">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <joint name="camera_depth_optical_frame_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0.12 0 0.04" rpy="1.57 0 1.57"/> <!-- Realsense is upside down on robot -->
  </joint>

</robot>

